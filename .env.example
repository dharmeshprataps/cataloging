# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Only GEMINI_API_KEY is needed to try the bot
# locally through the built-in simulator (http://localhost:3000).
# ---------------------------------------------------------------------------

# --- Gemini (image generation + brief parsing) ---
GEMINI_API_KEY=
# Current recommended workhorse. Alternatives:
#   gemini-nano-banana-2.1  (default, best multi-reference consistency)
#   gemini-3.1-flash-lite-image (cheapest/fastest, weak with multiple refs)
#   gemini-2.5-flash-image  (LEGACY - documented as superseded)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Text model used only to turn a free-form brief into structured JSON. A
# `-latest` alias is used deliberately so it does not pin a dated snapshot.
GEMINI_TEXT_MODEL=gemini-flash-latest

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# --- Storage ---
# Where uploaded + generated images live. Use a mounted volume in production.
STORAGE_DIR=./data/uploads
# SQLite database file.
DATABASE_PATH=./data/bot.db

# --- Messaging channel ---
# simulator | whatsapp | console
#   simulator -> local web chat UI (no Meta account needed)
#   whatsapp  -> real Meta WhatsApp Cloud API
#   console   -> exercises the whatsapp codepath but prints instead of sending
MESSAGING_CHANNEL=simulator

# --- WhatsApp Cloud API (only needed when MESSAGING_CHANNEL=whatsapp) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Pipeline tuning ---
# Batch bursty photo uploads into a single turn (ms).
MESSAGE_DEBOUNCE_MS=3000
# Cap generations per session to control cost.
MAX_GENERATIONS_PER_SESSION=15
# Number of alternates produced by the "variations" command.
VARIATIONS_COUNT=4
