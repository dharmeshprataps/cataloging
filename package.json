{
  "name": "wa-catalog-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traceability gate for the requirements baseline: keeps the specification and the test suite from drifting apart",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "./test.sh run && tsx scripts/spec-status.ts",
    "test:watch": "./test.sh",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "build": "tsc -p tsconfig.json",
    "spec:verify": "tsx scripts/spec-status.ts",
    "spec:status": "tsx scripts/spec-status.ts",
    "spec:sync": "tsx scripts/sync-traceability.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
