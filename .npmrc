# pnpm is invoked through ./run.sh, which selects the Node runtime.
#
# Disable the automatic "verify deps before run" preflight. On this machine it
# shells out in a way that fails with `spawn bash ENOENT` even though bash is
# present, which made `./run.sh pnpm typecheck` (and any `pnpm run <script>`)
# fail while the underlying command succeeds when invoked directly. The
# toolchain is already validated explicitly by `pnpm test` and `pnpm typecheck`.
verify-deps-before-run=false
